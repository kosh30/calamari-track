{
  "schemaVersion": 1,
  "id": "kosh.calamari-tracker",
  "name": "Calamari Tracker",
  "version": "0.2.0",
  "author": "kosh",
  "license": "MIT",
  "description": "Stempelt die eigene Arbeitszeit in Calamari über den offiziellen MCP-Server und erinnert an vergessenes Ein- und Ausstempeln",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Calamari Tracker",
    "description": "Schichtstatus und Stempeln für Calamari",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalMinutes": 3,
      "stampReminderMinutes": 5,
      "breakLimitMinutes": 30,
      "breakReminderMinutes": 5,
      "softHintMinutes": 30,
      "finalWarningTime": "19:00",
      "autoCloseMinutes": 15,
      "extendMinutes": 60,
      "hardLimitTime": "23:00",
      "webUrl": "",
      "apiUrl": "",
      "defaultProject": "Check-in",
      "breakType": "Break",
      "coreMonday": "",
      "coreTuesday": "",
      "coreWednesday": "",
      "coreThursday": "",
      "coreFriday": "",
      "coreSaturday": "",
      "coreSunday": ""
    },
    "schema": [
      {
        "key": "pollIntervalMinutes",
        "type": "integer",
        "label": "Abfrage-Intervall (Minuten)",
        "min": 1,
        "max": 60,
        "defaultValue": 3
      },
      {
        "key": "stampReminderMinutes",
        "type": "integer",
        "label": "Stempel-Erinnerung wiederholen alle (Minuten)",
        "min": 1,
        "max": 60,
        "defaultValue": 5
      },
      {
        "key": "breakLimitMinutes",
        "type": "integer",
        "label": "Pausen-Erinnerung nach (Minuten)",
        "min": 1,
        "max": 240,
        "defaultValue": 30
      },
      {
        "key": "breakReminderMinutes",
        "type": "integer",
        "label": "Pausen-Erinnerung wiederholen alle (Minuten)",
        "min": 1,
        "max": 60,
        "defaultValue": 5
      },
      {
        "key": "softHintMinutes",
        "type": "integer",
        "label": "Sanfter Hinweis nach Ende der Kernzeit (Minuten)",
        "min": 0,
        "max": 240,
        "defaultValue": 30
      },
      {
        "key": "finalWarningTime",
        "type": "string",
        "label": "Uhrzeit der letzten Warnung (HH:MM)",
        "format": "time",
        "defaultValue": "19:00"
      },
      {
        "key": "autoCloseMinutes",
        "type": "integer",
        "label": "Auto-Abschluss nach der letzten Warnung (Minuten)",
        "min": 1,
        "max": 120,
        "defaultValue": 15
      },
      {
        "key": "extendMinutes",
        "type": "integer",
        "label": "Verschiebung durch „+1 h“ (Minuten)",
        "min": 5,
        "max": 240,
        "defaultValue": 60
      },
      {
        "key": "hardLimitTime",
        "type": "string",
        "label": "Obergrenze für den Auto-Abschluss (HH:MM)",
        "format": "time",
        "defaultValue": "23:00"
      },
      {
        "key": "webUrl",
        "type": "string",
        "label": "Calamari im Browser (z.B. https://firma.calamari.io)",
        "format": "url",
        "defaultValue": ""
      },
      {
        "key": "apiUrl",
        "type": "string",
        "label": "Calamari-REST-API, z.B. https://firma.calamari.io/api (Key per bin/calamari api-key)",
        "format": "url",
        "defaultValue": ""
      },
      {
        "key": "defaultProject",
        "type": "string",
        "label": "Standard-Projekt beim Einstempeln (Name in Calamari, leer = Check-in)",
        "defaultValue": "Check-in"
      },
      {
        "key": "breakType",
        "type": "string",
        "label": "Pausentyp (Name in Calamari, leer = Break)",
        "defaultValue": "Break"
      },
      {
        "key": "coreMonday",
        "type": "string",
        "label": "Kernzeit Montag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreTuesday",
        "type": "string",
        "label": "Kernzeit Dienstag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreWednesday",
        "type": "string",
        "label": "Kernzeit Mittwoch (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreThursday",
        "type": "string",
        "label": "Kernzeit Donnerstag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreFriday",
        "type": "string",
        "label": "Kernzeit Freitag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreSaturday",
        "type": "string",
        "label": "Kernzeit Samstag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      },
      {
        "key": "coreSunday",
        "type": "string",
        "label": "Kernzeit Sonntag (HH:MM-HH:MM, frei, leer = Arbeitsplan aus Calamari)",
        "format": "coreTime",
        "defaultValue": ""
      }
    ]
  }
}
