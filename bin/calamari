#!/usr/bin/env python3
"""Calamari helper: the only part of the plugin that talks to Calamari.

Speaks OAuth (Dynamic Client Registration, Authorization Code + PKCE,
refresh) and MCP (Streamable HTTP, JSON-RPC) against the official Calamari
MCP server, see docs/adr/0001, and the REST API with the company API key
for what MCP cannot do, see docs/adr/0003. Every command prints exactly one JSON object
on stdout: {"ok": true, ...} or {"ok": false, "error": {"code", "message"}}
with a non-zero exit code.

Environment:
  CALAMARI_BASE_URL      gateway base URL (tests point it at a fake)
  CALAMARI_API_URL       REST API base URL (default DEFAULT_API_URL; the
                         widget setting apiUrl)
  CALAMARI_KEYRING_FILE  keep secrets in this JSON file instead of the
                         Secret Service keyring (tests only)
  CALAMARI_LOG_FILE      append log lines to this file instead of the
                         journal (tests only)

Failures and stamps go to the journal: journalctl -t calamari-tracker
  CALAMARI_NOW           local time "YYYY-MM-DDTHH:MM[:SS]" instead of the
                         clock (tests only)
  BROWSER                command that opens the login URL (default xdg-open)
"""

import argparse
import base64
import datetime
import fcntl
import getpass
import hashlib
import json
import os
import secrets
import shlex
import subprocess
import sys
import syslog
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, quote, urlencode, urlsplit, urlunsplit

DEFAULT_BASE_URL = "https://gateway.eu-west-1.calamari.io"
DEFAULT_API_URL = "https://cti.calamari.io/api"
# The project of the own clock-ins, as web and phone set it (widget setting defaultProject).
DEFAULT_PROJECT = "Check-in"
MCP_PATH = "/mcp-server/mcp"
SCOPE = "mcp"
KEYRING_SERVICE = "kosh.calamari-tracker"
LOG_IDENT = "calamari-tracker"
MCP_PROTOCOL_VERSION = "2025-06-18"
CLIENT_NAME = "Calamari Tracker (Omarchy)"
VERSION = "0.1.0"
HTTP_TIMEOUT = 20
LOGIN_TIMEOUT = 300
# Refresh a little before the server would reject the token.
EXPIRY_MARGIN = 60


class HelperError(Exception):
    def __init__(self, code, message, **details):
        super().__init__(message)
        self.code = code
        self.message = message
        # Extra fields of the error object, for the plugin's own wording.
        self.details = details


class Unauthorized(Exception):
    """The MCP server rejected the access token (HTTP 401)."""


def base_url():
    return os.environ.get("CALAMARI_BASE_URL", DEFAULT_BASE_URL).rstrip("/")


def mcp_url():
    return base_url() + MCP_PATH


def api_url():
    return os.environ.get("CALAMARI_API_URL", DEFAULT_API_URL).rstrip("/")


def well_known(url, name):
    """RFC 8414/9728: insert /.well-known/<name> between host and path."""
    parts = urlsplit(url)
    path = "/.well-known/" + name + parts.path.rstrip("/")
    return urlunsplit((parts.scheme, parts.netloc, path, "", ""))


# Keyring


class SecretToolKeyring:
    def get(self, key):
        try:
            proc = subprocess.run(["secret-tool", "lookup", "service", KEYRING_SERVICE, "key", key],
                                  capture_output=True, text=True)
        except FileNotFoundError:
            raise HelperError("KEYRING", "secret-tool is not installed")
        if proc.returncode != 0 and proc.stderr.strip():
            # A missing entry exits non-zero silently; anything else is a keyring problem.
            raise HelperError("KEYRING", "secret-tool lookup failed: " + proc.stderr.strip())
        return json.loads(proc.stdout) if proc.returncode == 0 and proc.stdout else None

    def set(self, key, value):
        try:
            proc = subprocess.run(["secret-tool", "store", "--label", "Calamari Tracker (%s)" % key,
                                   "service", KEYRING_SERVICE, "key", key],
                                  input=json.dumps(value), capture_output=True, text=True)
        except FileNotFoundError:
            raise HelperError("KEYRING", "secret-tool is not installed")
        if proc.returncode != 0:
            raise HelperError("KEYRING", "secret-tool store failed: " + proc.stderr.strip())


class FileKeyring:
    """Test stand-in: {key: json-string} in one file, like the keyring stores strings."""

    def __init__(self, path):
        self.path = path

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {}

    def get(self, key):
        raw = self._load().get(key)
        return json.loads(raw) if raw else None

    def set(self, key, value):
        data = self._load()
        data[key] = json.dumps(value)
        tmp = self.path + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(data, f)
        os.replace(tmp, self.path)


def keyring():
    path = os.environ.get("CALAMARI_KEYRING_FILE")
    return FileKeyring(path) if path else SecretToolKeyring()


def lock_path():
    path = os.environ.get("CALAMARI_KEYRING_FILE")
    if path:
        return path + ".lock"
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(runtime, "%s-%d.lock" % (KEYRING_SERVICE, os.getuid()))


# Journal


def log(level, text):
    """level "err" or "info". Never pass secrets: the journal is readable."""
    path = os.environ.get("CALAMARI_LOG_FILE")
    if path:
        with open(path, "a") as f:
            f.write("%s %s\n" % (level, text))
        return
    syslog.openlog(LOG_IDENT, 0, syslog.LOG_USER)
    syslog.syslog(syslog.LOG_ERR if level == "err" else syslog.LOG_INFO, text)


# HTTP


def http(url, data=None, headers=None, method=None):
    """Returns (status, headers, body bytes). HTTP errors are returned, not raised."""
    req = urllib.request.Request(url, data=data, headers=headers or {}, method=method)
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            return resp.status, resp.headers, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.headers, e.read()
    except (urllib.error.URLError, OSError) as e:
        raise HelperError("NETWORK", "cannot reach %s: %s" % (urlsplit(url).netloc, getattr(e, "reason", e)))


def check_status(status, body, what):
    if status == 429:
        raise HelperError("RATE_LIMITED", "%s: rate limited by Calamari" % what)
    if not 200 <= status < 300:
        raise HelperError("MCP_ERROR", "%s: HTTP %d %s" % (what, status, body[:200].decode(errors="replace")))


def get_json(url, what):
    status, _, body = http(url, headers={"Accept": "application/json"})
    check_status(status, body, what)
    return json.loads(body)


# OAuth


def discover():
    resource = get_json(well_known(mcp_url(), "oauth-protected-resource"), "resource metadata")
    issuer = resource["authorization_servers"][0]
    return get_json(well_known(issuer, "oauth-authorization-server"), "authorization server metadata")


def pkce_pair():
    verifier = secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def token_request(client, form):
    """POST to the token endpoint with client authentication. Returns (status, json)."""
    headers = {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"}
    form = dict(form, resource=client["resource"])
    method = client.get("token_endpoint_auth_method", "client_secret_basic")
    if method == "client_secret_basic" and client.get("client_secret"):
        pair = "%s:%s" % (quote(client["client_id"], safe=""), quote(client["client_secret"], safe=""))
        headers["Authorization"] = "Basic " + base64.b64encode(pair.encode()).decode()
    else:
        form["client_id"] = client["client_id"]
        if method == "client_secret_post":
            form["client_secret"] = client["client_secret"]
    status, _, body = http(client["token_endpoint"], urlencode(form).encode(), headers)
    try:
        payload = json.loads(body) if body else {}
    except json.JSONDecodeError:
        payload = {}
    return status, payload


def stored_tokens(payload, previous=None):
    return {
        "access_token": payload["access_token"],
        # Servers without rotation omit the refresh token on refresh.
        "refresh_token": payload.get("refresh_token") or (previous or {}).get("refresh_token"),
        "expires_at": time.time() + int(payload.get("expires_in", 3600)),
    }


class _CallbackHandler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        url = urlsplit(self.path)
        if url.path != "/callback":
            self.send_response(404)
            self.end_headers()
            return
        result = {k: v[0] for k, v in parse_qs(url.query).items()}
        if result.get("state") != self.server.state:
            # Not the answer to this login (stale tab, stray request): keep waiting.
            self.send_response(400)
            self.end_headers()
            return
        self.server.result = result
        ok = "code" in result
        body = ("<!doctype html><meta charset=utf-8><title>Calamari Tracker</title><p>%s</p>"
                % ("Anmeldung abgeschlossen. Dieses Fenster kann geschlossen werden." if ok
                   else "Anmeldung fehlgeschlagen.")).encode()
        self.send_response(200 if ok else 400)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def open_browser(url):
    command = shlex.split(os.environ.get("BROWSER") or "xdg-open")
    command = [a.replace("%s", url) for a in command] if any("%s" in a for a in command) else command + [url]
    try:
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass  # the URL is on stderr as a fallback


def login(args):
    meta = discover()
    if "registration_endpoint" not in meta:
        raise HelperError("LOGIN_FAILED", "the authorization server offers no client registration")

    server = HTTPServer(("127.0.0.1", 0), _CallbackHandler)
    server.result = None
    server.state = state = secrets.token_urlsafe(16)
    server.timeout = 1
    redirect_uri = "http://127.0.0.1:%d/callback" % server.server_port
    try:
        # A fresh registration per login: the redirect URI carries this run's port.
        status, _, body = http(meta["registration_endpoint"], json.dumps({
            "client_name": CLIENT_NAME,
            "redirect_uris": [redirect_uri],
            "grant_types": ["authorization_code", "refresh_token"],
            "response_types": ["code"],
            "scope": SCOPE,
            "token_endpoint_auth_method": "client_secret_basic",
        }).encode(), {"Content-Type": "application/json", "Accept": "application/json"})
        if status not in (200, 201):
            raise HelperError("LOGIN_FAILED", "client registration refused: HTTP %d %s"
                              % (status, body[:300].decode(errors="replace")))
        registered = json.loads(body)
        client = {
            "client_id": registered["client_id"],
            "client_secret": registered.get("client_secret"),
            "token_endpoint_auth_method": registered.get("token_endpoint_auth_method", "client_secret_basic"),
            "token_endpoint": meta["token_endpoint"],
            "resource": mcp_url(),
        }

        verifier, challenge = pkce_pair()
        authorize_url = meta["authorization_endpoint"] + "?" + urlencode({
            "response_type": "code",
            "client_id": client["client_id"],
            "redirect_uri": redirect_uri,
            "scope": SCOPE,
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "resource": client["resource"],
        })
        print("Öffne im Browser: " + authorize_url, file=sys.stderr)
        open_browser(authorize_url)

        deadline = time.monotonic() + LOGIN_TIMEOUT
        while server.result is None and time.monotonic() < deadline:
            server.handle_request()
        result = server.result
    finally:
        server.server_close()

    if result is None:
        raise HelperError("LOGIN_FAILED", "no answer from the browser within %d s" % LOGIN_TIMEOUT)
    if "code" not in result:
        raise HelperError("LOGIN_FAILED", "login refused: %s %s"
                          % (result.get("error", "?"), result.get("error_description", "")))

    status, payload = token_request(client, {
        "grant_type": "authorization_code",
        "code": result["code"],
        "redirect_uri": redirect_uri,
        "code_verifier": verifier,
    })
    if status != 200 or "access_token" not in payload:
        raise HelperError("LOGIN_FAILED", "token exchange failed: HTTP %d %s" % (status, payload.get("error", "")))

    store = keyring()
    store.set("client", client)
    store.set("tokens", stored_tokens(payload))
    # The login may belong to someone else: the REST calls ask for the person again.
    store.set("person", None)
    return {}


class Session:
    """Holds the credentials of one helper run and refreshes them when needed."""

    def __init__(self):
        self.store = keyring()
        self.client = self.store.get("client")
        self.tokens = self.store.get("tokens")
        if not self.client or not self.tokens:
            raise HelperError("AUTH_REQUIRED", "not logged in, run `calamari login`")

        self.refreshed = False

    def access_token(self):
        if not self.refreshed and time.time() > self.tokens.get("expires_at", 0) - EXPIRY_MARGIN:
            self.refresh()
        return self.tokens["access_token"]

    def refresh(self):
        """Refresh under a lock: the refresh token rotates, so concurrent runs
        must not spend the same one. A run that waited picks up the winner's."""
        with open(lock_path(), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            latest = self.store.get("tokens") or {}
            if latest.get("access_token") not in (None, self.tokens["access_token"]):
                self.tokens, self.refreshed = latest, True
                return
            if not self.tokens.get("refresh_token"):
                raise HelperError("AUTH_REQUIRED", "no refresh token, run `calamari login`")
            status, payload = token_request(self.client, {
                "grant_type": "refresh_token",
                "refresh_token": self.tokens["refresh_token"],
            })
            if status in (400, 401):  # invalid_grant / invalid_client: the login is gone
                raise HelperError("AUTH_REQUIRED", "token refresh refused (%s), run `calamari login`"
                                  % (payload.get("error") or "HTTP %d" % status))
            check_status(status, json.dumps(payload).encode(), "token refresh")
            if "access_token" not in payload:
                raise HelperError("MCP_ERROR", "token refresh: no access token in the answer")
            self.tokens = stored_tokens(payload, self.tokens)
            self.store.set("tokens", self.tokens)
            self.refreshed = True


# MCP


def parse_sse(body):
    """Yields the JSON payload of each event in a text/event-stream body."""
    for event in body.decode().replace("\r\n", "\n").split("\n\n"):
        data = "\n".join(line[5:].lstrip(" ") for line in event.split("\n") if line.startswith("data:"))
        if data:
            yield json.loads(data)


class McpClient:
    def __init__(self, session):
        self.session = session
        self.session_id = None
        self.protocol_version = MCP_PROTOCOL_VERSION
        self.next_id = 1

    def post(self, message):
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "Authorization": "Bearer " + self.session.access_token(),
            "MCP-Protocol-Version": self.protocol_version,
        }
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
        status, resp_headers, body = http(mcp_url(), json.dumps(message).encode(), headers)
        if status == 401:
            raise Unauthorized()
        check_status(status, body, "MCP " + message["method"])
        if "id" not in message:
            return None, resp_headers
        if (resp_headers.get("Content-Type") or "").startswith("text/event-stream"):
            reply = next((m for m in parse_sse(body) if m.get("id") == message["id"]), None)
        else:
            reply = json.loads(body)
        if reply is None:
            raise HelperError("MCP_ERROR", "MCP %s: no reply in the event stream" % message["method"])
        if "error" in reply:
            raise HelperError("MCP_ERROR", "MCP %s: %s" % (message["method"], reply["error"].get("message")))
        return reply["result"], resp_headers

    def request(self, method, params):
        message = {"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params}
        self.next_id += 1
        return self.post(message)

    def open(self):
        result, headers = self.request("initialize", {
            "protocolVersion": MCP_PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": {"name": "calamari-tracker", "version": VERSION},
        })
        self.session_id = headers.get("Mcp-Session-Id")
        self.protocol_version = result.get("protocolVersion") or self.protocol_version
        self.post({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def call_tool(self, name, arguments):
        result, _ = self.request("tools/call", {"name": name, "arguments": arguments})
        text = "\n".join(c.get("text", "") for c in result.get("content", []) if c.get("type") == "text")
        if result.get("isError"):
            raise HelperError("MCP_ERROR", "%s: %s" % (name, text or "tool error"))
        if "structuredContent" in result:
            return result["structuredContent"]
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            return text


def with_mcp(work):
    """Runs work(client) in one MCP session, refreshing the token once on 401."""
    session = Session()
    for attempt in range(2):
        try:
            client = McpClient(session)
            client.open()
            return work(client)
        except Unauthorized:
            if attempt == 0:
                session.refresh()
    raise HelperError("AUTH_REQUIRED", "Calamari rejects the refreshed token, run `calamari login`")


# Start and end times via checkTimesheetOverlap, see docs/adr/0001: a
# running shift counts as an entry up to now. Windows are whole minutes;
# touching ends do not overlap.


def now():
    fixed = os.environ.get("CALAMARI_NOW")
    return datetime.datetime.fromisoformat(fixed) if fixed else datetime.datetime.now()


def hhmm(minute):
    return "%02d:%02d" % divmod(minute, 60)


def parse_hhmm(text):
    try:
        t = datetime.datetime.strptime(text, "%H:%M")
    except ValueError:
        raise HelperError("USAGE", "expected HH:MM, got %r" % text)
    return t.hour * 60 + t.minute


def overlaps(client, date, start, end):
    dates = client.call_tool("checkTimesheetOverlap", {
        "entries": [{"date": date, "fromTime": hhmm(start), "toTime": hhmm(end)}],
        "skipNotEligibleDays": False,
    })
    if not isinstance(dates, list):
        raise HelperError("MCP_ERROR", "checkTimesheetOverlap: unexpected answer %r" % (dates,))
    return date in dates


def today_and_minute():
    t = now()
    return t.strftime("%Y-%m-%d"), t.hour * 60 + t.minute


# Commands


def my_profile(client):
    profile = client.call_tool("getMyProfile", {})
    if not isinstance(profile, dict) or not profile.get("name") or not profile.get("email"):
        raise HelperError("MCP_ERROR", "getMyProfile: unexpected answer %r" % (profile,))
    return profile


def whoami(args):
    profile = with_mcp(my_profile)
    return {"name": profile["name"], "email": profile["email"], "personUuid": profile.get("personUuid")}


def tools(args):
    """The MCP server's tool list, sorted by name. docs/mcp-tools.json holds
    a snapshot; a diff against it shows when Calamari changes the tools
    this plugin works around (docs/adr/0001)."""
    result = with_mcp(lambda c: c.request("tools/list", {})[0])
    return {"tools": sorted(result.get("tools", []), key=lambda t: t.get("name", ""))}


def day_end(args):
    """Whether a shift was still open at the end of that day. Calamari ends
    an open shift at 23:59 (company policy), so the next morning nothing
    runs any more, but the entry's end time is wrong. The last two minutes
    of the day tell that apart from a shift the user ended themselves."""
    try:
        date = datetime.date.fromisoformat(args.date).isoformat()
    except ValueError:
        raise HelperError("USAGE", "expected YYYY-MM-DD, got %r" % args.date)
    last = 24 * 60 - 1
    return {"ranToMidnight": with_mcp(lambda c: overlaps(c, date, last - 1, last))}


def clock_out(args):
    """Stamps now, but only while a shift runs: a clockOut without one still
    leaves a seconds-long entry in Calamari (seen 2026-09-22). "Runs" means
    it reaches into the current minute, which a shift ended a minute ago
    does not. stamped tells whether clockOut was sent. There is no check
    afterwards: the shift just ended still overlaps every window up to now
    (docs/adr/0001)."""
    def work(client):
        date, minute = today_and_minute()
        start = min(minute, 24 * 60 - 2)
        running = overlaps(client, date, start, start + 1)
        if running:
            client.call_tool("clockOut", {})
            log("info", "clock-out: clockOut sent")
        return running

    return {"running": False, "stamped": with_mcp(work)}


def first_minute(lo, hi, holds):
    """The first minute in [lo, hi] where holds (monotone, true at hi) is true."""
    while lo < hi:
        mid = (lo + hi) // 2
        if holds(mid):
            hi = mid
        else:
            lo = mid + 1
    return lo


def start_time(args):
    """Bisects the first minute x after --after where [after, x] overlaps. The
    shift began during minute x - 1 (verified against a real shift)."""
    date, minute = today_and_minute()
    after = parse_hhmm(args.after) if args.after else 0
    if after >= minute:
        return {"startedAt": None}

    def search(client):
        if not overlaps(client, date, after, minute):
            return None
        return hhmm(first_minute(after + 1, minute, lambda m: overlaps(client, date, after, m)) - 1)

    return {"startedAt": with_mcp(search)}


WEEKDAYS = ("MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY")


def day_info(args):
    """Working day and core time of one date from the weekly work plan, plus
    the public holiday and the own absence on it. Of several it keeps the one
    that frees the most (whole before half holiday; whole-day time off before
    hourly time off before working absences); what that means for reminders
    (free day, shortened core time) is left to the plugin."""
    try:
        date = datetime.date.fromisoformat(args.date) if args.date else now().date()
    except ValueError:
        raise HelperError("USAGE", "expected YYYY-MM-DD, got %r" % args.date)
    day = date.isoformat()

    def fetch_day(client):
        plan = client.call_tool("getWorkPlan", {})
        holidays = client.call_tool("getPublicHolidays", {"from": day, "to": day})
        me = client.call_tool("getMyProfile", {})
        # Without peopleUuids search returns the absences of the whole company.
        absences = client.call_tool("search", {"from": day, "to": day, "peopleUuids": [me["personUuid"]]})
        return plan, holidays, absences

    plan, holidays, absences = with_mcp(fetch_day)
    weekday = WEEKDAYS[date.weekday()]
    entry = next((d for d in plan.get("days", []) if d.get("dayOfWeek") == weekday), None) \
        if isinstance(plan, dict) else None
    if entry is None:
        raise HelperError("MCP_ERROR", "getWorkPlan: no entry for %s in %r" % (weekday, plan))
    working = entry.get("workingDay") is True

    on_day = [h for h in holidays.get("holidays", []) if h.get("start", "") <= day <= h.get("end", "")]
    on_day.sort(key=lambda h: h.get("halfDay") is True)
    holiday = on_day[0] if on_day else None
    # end is the last day of the absence (verified against real ones).
    own = [a for a in absences.get("absences", []) if a.get("start", "")[:10] <= day <= a.get("end", "")[:10]]
    own.sort(key=lambda a: (a.get("category") != "TIMEOFF", a.get("fullDayRequest") is not True))
    absence = own[0] if own else None
    return {"date": day, "workingDay": working,
            "coreStart": entry.get("startTime") if working else None,
            "coreEnd": entry.get("finishTime") if working else None,
            "holiday": holiday and {"name": (holiday.get("name") or "").strip(), "halfDay": holiday.get("halfDay") is True,
                                    "halfdayPeriod": holiday.get("halfdayPeriod")},
            "absence": absence and {"category": absence.get("category"),
                                    "fullDay": absence.get("fullDayRequest") is True}}


def end_time(args):
    """The end minute of the last shift since --after: bisects the first
    minute y where [y, now] no longer overlaps; the shift ended during
    minute y - 1. Asked once a shift is seen gone, so none runs now."""
    date, minute = today_and_minute()
    after = parse_hhmm(args.after)
    if after >= minute:
        return {"endedAt": None}

    def search(client):
        if not overlaps(client, date, after, minute):
            return None
        return hhmm(first_minute(after + 1, minute, lambda m: not overlaps(client, date, m, minute)) - 1)

    return {"endedAt": with_mcp(search)}


# REST API with the company API key, for what the MCP server cannot do
# (docs/adr/0003). The key lives in the keyring like the OAuth tokens.


def api_key(args):
    """Stores the API key read from stdin; a terminal gets a hidden prompt,
    so the key never shows up in the shell history."""
    try:
        key = getpass.getpass("Calamari API key: ", stream=sys.stderr) if sys.stdin.isatty() else sys.stdin.readline()
    except EOFError:
        key = ""
    key = key.strip()
    if not key:
        raise HelperError("USAGE", "no API key on stdin")
    keyring().set("apiKey", key)
    return {}


class RestClient:
    """Calls for the user only: the key could act for anyone in the company,
    so every call names the person from the user's own profile."""

    def __init__(self):
        store = keyring()
        key = store.get("apiKey")
        if not key:
            raise HelperError("API_KEY_REQUIRED", "no API key, run `calamari api-key`")
        self.auth = "Basic " + base64.b64encode(("calamari:" + key).encode()).decode()
        self.person = own_person(store)

    def call(self, path, body=None):
        """POSTs body plus the own person; returns the parsed answer."""
        payload = dict(body or {}, person=self.person)
        headers = {"Content-Type": "application/json", "Accept": "application/json", "Authorization": self.auth}
        status, _, raw = http(api_url() + path, json.dumps(payload).encode(), headers)
        if not 200 <= status < 300:
            log("err", "REST %s sent %s, got HTTP %d %s"
                % (path, json.dumps(payload), status, raw[:500].decode(errors="replace")))
            raise rest_error(path, status, raw)
        return json.loads(raw) if raw else None


def rest_error(path, status, raw):
    """Calamari's {message, code, field} as a helper error. None of these
    means the OAuth login is gone, so none is AUTH_REQUIRED."""
    try:
        body = json.loads(raw)
    except ValueError:
        body = None
    body = body if isinstance(body, dict) else {}
    code = body.get("code")
    detail = "%s: %s" % (code, body.get("message")) if code else "HTTP %d %s" % (status, raw[:200].decode(errors="replace"))
    if status == 401:
        return HelperError("API_KEY_REJECTED", "Calamari rejects the API key (%s), run `calamari api-key`" % detail)
    if status == 403:
        return HelperError("API_SCOPE_MISSING", "the API key lacks the scope for %s (%s)" % (path, detail))
    if status == 429:
        return HelperError("RATE_LIMITED", "%s: rate limited by Calamari (%s)" % (path, detail))
    if code == "API_TERMINAL_NOT_AVAILABLE":
        return HelperError("API_TERMINAL_MISSING", "no API terminal in Clockin for this person (%s)" % detail)
    return HelperError("API_ERROR", "%s: %s" % (path, detail))


def own_person(store):
    """The e-mail the REST calls act for, from the profile behind the user's
    login; cached in the keyring until the next login."""
    person = store.get("person")
    if not person:
        person = with_mcp(my_profile)["email"]
        store.set("person", person)
    return person


def projects(client):
    return id_names(client, "/clockin/projects/v1/get-projects-for-person")


def id_names(client, path):
    """A REST list of the own person, reduced to [{id, name}]."""
    items = client.call(path)
    if not isinstance(items, list):
        raise HelperError("API_ERROR", "%s: unexpected answer %r" % (path, items))
    return [{"id": i.get("id"), "name": i.get("name")} for i in items if isinstance(i, dict)]


def clock_in(args):
    """Stamps now over REST with the project named by --project, so the
    shift is not "Ohne Projekt" (docs/adr/0003). An unknown name stamps
    nothing, and a REST failure never falls back to MCP clockIn. Calamari
    ignores a clock-in during a running shift; its shiftStatus tells how
    things stand afterwards either way."""
    client = RestClient()
    name = args.project.strip()
    project = next((p for p in projects(client) if p["name"] == name), None)
    if project is None:
        raise HelperError("PROJECT_UNKNOWN", "Calamari has no project %r for %s" % (name, client.person),
                          project=name)
    body = {
        # Local time without zone: Calamari answers "Incorrect value" to Z,
        # +02:00, +0200 and milliseconds (tried 2026-09-24).
        "time": now().strftime("%Y-%m-%dT%H:%M:%S"),
        "projectId": project["id"],
    }
    answer = client.call("/clockin/terminal/v1/clock-in", body)
    log("info", "clock-in: sent %s, got %s" % (json.dumps(body), json.dumps(answer)))
    shift = answer.get("shiftStatus") if isinstance(answer, dict) else None
    if shift not in ("STARTED", "FINISHED"):
        raise HelperError("API_ERROR", "clock-in: unexpected answer %r" % (answer,))
    return {"running": shift == "STARTED"}


# Calamari's shift status and the plugin's word for it.
SHIFT_STATUS = {"STARTED": "running", "BREAK": "break", "STOPPED": "stopped"}


def status(args):
    """The shift status over REST (docs/adr/0003): "running", "break" (a
    Pause inside the running shift) or "stopped". While a shift runs, also
    startedAt and breakSince (HH:MM local, the open break's start) from
    today's timesheet entry; null if that cannot be read, which costs only
    the times, not the status."""
    client = RestClient()
    answer = client.call("/clockin/shift/status/v1/get-current")
    shift = SHIFT_STATUS.get(answer.get("status")) if isinstance(answer, dict) else None
    if shift is None:
        raise HelperError("API_ERROR", "get-current: unexpected answer %r" % (answer,))
    times = {"startedAt": None, "breakSince": None}
    if shift != "stopped":
        try:
            times = open_entry_times(client)
        except HelperError as e:
            log("err", "status: no times of the running shift: %s %s" % (e.code, e.message))
    return dict(times, shift=shift)


def open_entry_times(client):
    """Start of today's open timesheet entry and of its open break."""
    today = now().date().isoformat()
    # Without employees the answer holds the whole company.
    entries = client.call("/clockin/timesheetentries/v1/find",
                          {"from": today, "to": today, "employees": [client.person]})
    if not isinstance(entries, list):
        raise HelperError("API_ERROR", "timesheetentries/find: unexpected answer %r" % (entries,))
    entry = next((e for e in entries if isinstance(e, dict) and e.get("started") and not e.get("finished")), None)
    if entry is None:
        return {"startedAt": None, "breakSince": None}
    open_break = next((b for b in entry.get("breaks") or [] if b.get("from") and not b.get("to")), None)
    return {"startedAt": local_hhmm(entry["started"]),
            "breakSince": local_hhmm(open_break["from"]) if open_break else None}


def local_hhmm(stamp):
    """HH:MM local of a REST timestamp like 2026-09-24T09:24:53+0000."""
    try:
        moment = datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%S%z")
    except (TypeError, ValueError):
        raise HelperError("API_ERROR", "unexpected timestamp %r" % (stamp,))
    return moment.astimezone().strftime("%H:%M")


def lookup(args):
    """The projects and break types Calamari offers the user, the names
    the default project and break type settings can pick from."""
    client = RestClient()
    return {
        "person": client.person,
        "projects": projects(client),
        "breakTypes": id_names(client, "/clockin/terminal/v1/get-break-types-for-person"),
    }


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise HelperError("USAGE", message)


def parse_args(argv):
    parser = _Parser(prog="calamari", add_help=False)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=_Parser)
    for name, run in COMMANDS.items():
        sub = commands.add_parser(name, add_help=False)
        sub.set_defaults(run=run)
        if name == "start-time":
            sub.add_argument("--after", metavar="HH:MM")
        if name == "end-time":
            sub.add_argument("--after", metavar="HH:MM", required=True)
        if name == "day-info":
            sub.add_argument("--date", metavar="YYYY-MM-DD")
        if name == "day-end":
            sub.add_argument("--date", metavar="YYYY-MM-DD", required=True)
        if name == "clock-in":
            sub.add_argument("--project", metavar="NAME", default=DEFAULT_PROJECT)
    return parser.parse_args(argv)


COMMANDS = {"login": login, "whoami": whoami, "tools": tools, "status": status, "start-time": start_time,
            "end-time": end_time, "clock-in": clock_in, "clock-out": clock_out, "day-info": day_info,
            "day-end": day_end, "api-key": api_key, "lookup": lookup}


def main(argv):
    try:
        args = parse_args(argv)
        out = dict(ok=True, **args.run(args))
        code = 0
    except HelperError as e:
        out, code = {"ok": False, "error": dict(e.details, code=e.code, message=e.message)}, 1
    except Exception as e:  # never break the one-JSON-object contract
        out, code = {"ok": False, "error": {"code": "INTERNAL", "message": "%s: %s" % (type(e).__name__, e)}}, 1
    if code:
        try:
            log("err", "%s failed: %s %s" % (argv[0] if argv else "(no command)", out["error"]["code"],
                                             out["error"]["message"]))
        except OSError:
            pass  # a broken log must not cost the answer
    print(json.dumps(out, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
